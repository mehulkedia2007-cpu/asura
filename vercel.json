{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "buildCommand": "python scripts/deploy_backend.py",
  "regions": ["sin1"],
  "functions": {
    "app.py": {
      "maxDuration": 300,
      "excludeFiles": "apps/web/**",
      "includeFiles": "{apps/api/daari/**,packages/core/daari_core/**,data/**,evals/**,docs/**}"
    }
  }
}
