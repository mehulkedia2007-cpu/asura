# DAARI (Team ASURA) — copy to .env and fill. .env is human-owned; Claude Code never reads or edits it.
# Nothing here requires a card. Blank optional keys are fine — /health reports what is live.

# --- LLM provider chain (at least ONE of the two required) ---
# aistudio.google.com -> Get API key       (also the default tool-calling provider)
GEMINI_API_KEY=
# console.groq.com -> API keys             (also powers ASR: whisper-large-v3)
GROQ_API_KEY=

# --- Live job sources (Adzuna required for demand weights; SerpAPI optional, budgeted) ---
# developer.adzuna.com -> sign up -> app id + key (free, no card)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# serpapi.com -> free plan, 100 searches/month, no card. Used for local gig queries only.
SERPAPI_KEY=
# Hard budget: /health reports what is left. Rehearsal + demo only.
SERPAPI_MONTHLY_BUDGET=100
# Random string, 16+ chars. Set the same value on the Vercel API project; cron routes refuse without it.
CRON_SECRET=
# data.gov.in -> Sign in -> My Account -> API key (optional; only if a scheme dataset is used)
DATAGOV_KEY=
# Remotive and myscheme.gov.in need no key (myscheme uses the portal's own public x-api-key,
# which lives in data/sources.yaml, not here).
#
# Paste check, because a truncated paste looks exactly like a wrong key:
#   ADZUNA_APP_ID   8 hex chars      ADZUNA_APP_KEY  32 hex chars
#   SERPAPI_KEY     64 hex chars     GROQ_API_KEY    starts gsk_

# --- Local infra (defaults match docker-compose.yml; leave as-is) ---
DATABASE_URL=postgresql+asyncpg://daari:daari@localhost:5432/daari
REDIS_URL=redis://localhost:6379/0
OLLAMA_BASE_URL=http://localhost:11434

# --- App ---
APP_ENV=local
LOG_LEVEL=info
LLM_CACHE_DIR=.cache/llm
# Demand weights, CAT item selection and embeddings are seeded from this.
DAARI_SEED=1337
# Default district for demand weighting and lead radius.
DEFAULT_DISTRICT=Guntur

# --- Voice (no keys needed; listed so /health can report the chosen voices) ---
TTS_VOICE_TE=te-IN-ShrutiNeural
TTS_VOICE_HI=hi-IN-SwaraNeural
TTS_VOICE_EN=en-IN-NeerjaNeural

# --- OPTIONAL: deploy only (hour 9:15, cut line 9). Leave blank to skip deploy entirely. ---
# supabase.com -> project asura-daari (Singapore) -> Session-mode pooler string
PROD_DATABASE_URL=
# upstash.com -> Redis, free, Singapore
PROD_REDIS_URL=
# huggingface.co -> Settings -> Access Tokens -> write
HF_TOKEN=
HF_SPACE_ID=
# vercel.com -> sign in with GitHub (vercel CLI logs in interactively; no key needed)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
